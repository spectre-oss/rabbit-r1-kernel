+/* SPDX-License-Identifier: GPL-2.0 */
+#include <linux/string.h>
+#include <linux/netdevice.h>
+static inline size_t r1_strlcpy(char *dst, const char *src, size_t size)
+{
+    size_t len = strlen(src);
+    if (size) { size_t count = min(len, size - 1); memcpy(dst, src, count); dst[count] = 0; }
+    return len;
+}
+#define strlcpy r1_strlcpy
+static inline unsigned long r1_core_dropped(struct net_device *dev, bool tx)
+{
+    struct rtnl_link_stats64 storage;
+    const struct rtnl_link_stats64 *s = dev_get_stats(dev, &storage);
+    return tx ? s->tx_dropped - dev->stats.tx_dropped : s->rx_dropped - dev->stats.rx_dropped;
+}
