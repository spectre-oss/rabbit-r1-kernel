+// SPDX-License-Identifier: GPL-2.0-only
+/* Rabbit R1 BOE 480x640 ST7701-class panel, exact active vendor sequence.
+ * The board's existing bias rails stay powered. This driver owns reset and
+ * DSI commands, not MT6370 bias power management or suspend-to-RAM.
+ */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/media-bus-format.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct r1_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset;
+	bool initialized;
+	bool displaying;
+};
+
+struct r1_command {
+	u16 delay_ms;
+	u8 len;
+	u8 data[17];
+};
+
+static const struct r1_command r1_init[] = {
+#include <generated/rabbit-r1-panel-init.h>
+};
+
+static struct r1_panel *to_r1(struct drm_panel *panel)
+{
+	return container_of(panel, struct r1_panel, panel);
+}
+
+static int r1_prepare(struct drm_panel *panel)
+{
+	struct r1_panel *r = to_r1(panel);
+	int ret;
+	size_t i;
+
+	/* reset-gpios is active-low: physical HIGH 50 / LOW 50 / HIGH 150 ms. */
+	ret = gpiod_direction_output(r->reset, 0);
+	if (ret)
+		return ret;
+	msleep(50);
+	gpiod_set_value_cansleep(r->reset, 1);
+	msleep(50);
+	gpiod_set_value_cansleep(r->reset, 0);
+	msleep(150);
+	r->initialized = false;
+	for (i = 0; i < ARRAY_SIZE(r1_init); i++) {
+		const struct r1_command *c = &r1_init[i];
+
+		if (c->delay_ms) {
+			msleep(c->delay_ms);
+			continue;
+		}
+		/* Vendor DSI_set_cmdq_V2 uses generic packets for bank commands. */
+		if (c->data[0] >= 0xb0)
+			ret = mipi_dsi_generic_write(r->dsi, c->data, c->len);
+		else
+			ret = mipi_dsi_dcs_write_buffer(r->dsi, c->data, c->len);
+		if (ret < 0) {
+			gpiod_set_value_cansleep(r->reset, 1);
+			dev_err(panel->dev, "init command %zu (0x%02x): %d\n", i, c->data[0], ret);
+			return ret;
+		}
+	}
+	dev_info(panel->dev, "vendor reset and 38-command initialization complete\n");
+	r->initialized = true;
+	return 0;
+}
+
+static int r1_enable(struct drm_panel *panel)
+{
+	static const u8 on[] = { 0x29, 0x00 };
+	int ret = mipi_dsi_dcs_write_buffer(to_r1(panel)->dsi, on, sizeof(on));
+
+	if (ret < 0)
+		return ret;
+	msleep(60);
+	to_r1(panel)->displaying = true;
+	return 0;
+}
+
+static int r1_disable(struct drm_panel *panel)
+{
+	int ret = mipi_dsi_dcs_set_display_off(to_r1(panel)->dsi);
+
+	to_r1(panel)->displaying = false;
+	msleep(50);
+	return ret;
+}
+
+static int r1_unprepare(struct drm_panel *panel)
+{
+	struct r1_panel *r = to_r1(panel);
+	int ret = mipi_dsi_dcs_enter_sleep_mode(r->dsi);
+
+	msleep(250);
+	gpiod_set_value_cansleep(r->reset, 1);
+	r->initialized = false;
+	return ret;
+}
+
+/* 260 Mbit/s per lane at RGB888 / two lanes. Actual refresh needs measurement. */
+static const struct drm_display_mode r1_mode = {
+	.clock = 21667,
+	.hdisplay = 480, .hsync_start = 500, .hsync_end = 520, .htotal = 540,
+	.vdisplay = 640, .vsync_start = 666, .vsync_end = 668, .vtotal = 682,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int r1_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	static const u32 format = MEDIA_BUS_FMT_RGB888_1X24;
+	struct drm_display_mode *mode = drm_mode_duplicate(connector->dev, &r1_mode);
+	int ret;
+
+	if (!mode)
+		return -ENOMEM;
+	ret = drm_display_info_set_bus_formats(&connector->display_info, &format, 1);
+	if (ret) {
+		drm_mode_destroy(connector->dev, mode);
+		return ret;
+	}
+	connector->display_info.bpc = 8;
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+	return 1;
+}
+
+static const struct drm_panel_funcs r1_panel_funcs = {
+	.prepare = r1_prepare, .enable = r1_enable,
+	.disable = r1_disable, .unprepare = r1_unprepare,
+	.get_modes = r1_get_modes,
+};
+
+static ssize_t ready_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct r1_panel *r = dev_get_drvdata(dev);
+	return sysfs_emit(buf, "%u\n", READ_ONCE(r->initialized) && READ_ONCE(r->displaying));
+}
+static DEVICE_ATTR_RO(ready);
+static struct attribute *r1_panel_attrs[] = { &dev_attr_ready.attr, NULL };
+ATTRIBUTE_GROUPS(r1_panel);
+
+static int r1_panel_probe(struct mipi_dsi_device *dsi)
+{
+	struct r1_panel *r;
+	int ret;
+
+	r = devm_drm_panel_alloc(&dsi->dev, struct r1_panel, panel,
+				 &r1_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(r))
+		return PTR_ERR(r);
+	r->dsi = dsi;
+	r->reset = devm_gpiod_get(&dsi->dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(r->reset))
+		return dev_err_probe(&dsi->dev, PTR_ERR(r->reset), "reset GPIO\n");
+	r->panel.prepare_prev_first = true;
+	dsi->lanes = 2;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+	mipi_dsi_set_drvdata(dsi, r);
+	drm_panel_add(&r->panel);
+	ret = mipi_dsi_attach(dsi);
+	if (ret)
+		drm_panel_remove(&r->panel);
+	return ret;
+}
+
+static void r1_panel_remove(struct mipi_dsi_device *dsi)
+{
+	struct r1_panel *r = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_disable(&r->panel);
+	drm_panel_unprepare(&r->panel);
+	if (dsi->attached)
+		mipi_dsi_detach(dsi);
+	drm_panel_remove(&r->panel);
+}
+
+static const struct of_device_id r1_panel_match[] = {
+	{ .compatible = "rabbit,r1-st7701-panel" }, {}
+};
+MODULE_DEVICE_TABLE(of, r1_panel_match);
+
+static struct mipi_dsi_driver r1_panel_driver = {
+	.probe = r1_panel_probe, .remove = r1_panel_remove,
+	.driver = { .name = "panel-rabbit-r1", .of_match_table = r1_panel_match,
+		    .dev_groups = r1_panel_groups },
+};
+module_mipi_dsi_driver(r1_panel_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Rabbit R1 ST7701-class BOE panel");
