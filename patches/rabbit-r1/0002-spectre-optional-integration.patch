+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Generate the private panel table from an explicitly supplied vendor source.
+
+No vendor table bytes are distributed by this script. It does not download or
+execute the input. Users must have permission to use the supplied source; this
+utility does not grant redistribution rights over the generated header or image.
+"""
+import argparse
+import hashlib
+from pathlib import Path
+import re
+
+SOURCE_SHA256 = '9fd1eb026a320b1a63fd78cc3739663e0f2fb28db3ec090f0d46a2b0a8d69fc9'
+
+
+def extract(source: str) -> list[str]:
+    text = re.sub(r'/\*.*?\*/|//[^\n]*', '', source, flags=re.S)
+    tables = re.findall(r'init_setting_vdo\[\]\s*=\s*\{(.*?)\n\};', text, flags=re.S)
+    if len(tables) != 1:
+        raise ValueError('Expected exactly one active initialization table')
+    entries = re.findall(r'\{\s*(\w+)\s*,\s*(0x[\da-fA-F]+|\d+)\s*,\s*\{([^{}]*)\}\s*\}', tables[0])
+    result = []
+    for command, count, values in entries:
+        count = int(count, 0)
+        if command == 'REGFLAG_DELAY':
+            if not 0 <= count <= 1000:
+                raise ValueError('Invalid delay')
+            result.append(f'\t{{ .delay_ms = {count} }},')
+            continue
+        if not re.fullmatch(r'0x[\da-fA-F]+|\d+', command):
+            raise ValueError('Unexpected control before MADCTL')
+        command = int(command, 0)
+        data = [int(value.strip(), 0) for value in values.split(',') if value.strip()]
+        if count != len(data) or count > 63 or any(not 0 <= value <= 255 for value in [command] + data):
+            raise ValueError('Invalid panel command')
+        encoded = ', '.join(f'0x{value:02x}' for value in [command] + data)
+        result.append(f'\t{{ .len = {count + 1}, .data = {{ {encoded} }} }},')
+        if command == 0x36:
+            return result
+    raise ValueError('Missing MADCTL terminator')
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('source', type=Path)
+    parser.add_argument('output_directory', type=Path)
+    args = parser.parse_args()
+    output = (args.output_directory / 'include/generated/rabbit-r1-panel-init.h').resolve()
+    if output.is_relative_to(Path(__file__).resolve().parents[2]):
+        parser.error('Private panel output must stay outside the source tree')
+    raw = args.source.read_bytes()
+    if hashlib.sha256(raw).hexdigest() != SOURCE_SHA256:
+        parser.error('Vendor input does not match the recorded source hash')
+    text = raw.decode()
+    lines = extract(text)
+    # Preserve the vendor notice instead of assigning it a new license.
+    notices = text[:text.index('#define LOG_TAG')]
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text('/* Generated private build input; do not commit. */\n' + notices + '\n' + '\n'.join(lines) + '\n')
+    print(f'Prepared {len(lines)} panel steps in the build output.')
+
+
+if __name__ == '__main__':
+    main()
