+/* SPDX-License-Identifier: GPL-2.0 */
+/* Adapt non-MLO soc1 driver callbacks to Linux 7.1, rejecting other links. */
+static int r1_add_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+			   int link_id, u8 key_index, bool pairwise,
+			   const u8 *mac_addr, struct key_params *params)
+{
+    if (link_id > 0 || !wdev->netdev) return -EOPNOTSUPP;
+    return mtk_cfg_add_key(wiphy, wdev->netdev, key_index, pairwise, mac_addr, params);
+}
+static int r1_get_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+			   int link_id, u8 key_index, bool pairwise,
+			   const u8 *mac_addr, void *cookie,
+			   void (*callback)(void *cookie, struct key_params*))
+{
+    if (link_id > 0 || !wdev->netdev) return -EOPNOTSUPP;
+    return mtk_cfg_get_key(wiphy, wdev->netdev, key_index, pairwise, mac_addr, cookie, callback);
+}
+static int r1_del_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+			   int link_id, u8 key_index, bool pairwise,
+			   const u8 *mac_addr)
+{
+    if (link_id > 0 || !wdev->netdev) return -EOPNOTSUPP;
+    return mtk_cfg_del_key(wiphy, wdev->netdev, key_index, pairwise, mac_addr);
+}
+static int r1_set_default_key(struct wiphy *wiphy,
+				   struct net_device *netdev, int link_id,
+				   u8 key_index, bool unicast, bool multicast)
+{
+    if (link_id > 0) return -EOPNOTSUPP;
+    return mtk_cfg_set_default_key(wiphy, netdev, key_index, unicast, multicast);
+}
